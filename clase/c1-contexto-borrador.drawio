<mxfile host="app.diagrams.net">
  <diagram name="C1-Contexto-RedExpress" id="c1-redexpress-diag">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Sistema en alcance: Plataforma RedExpress -->
        <mxCell id="sys_redexpress" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Plataforma RedExpress&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#e0e0e0&quot;&gt;Plataforma central de logística, gestión de envíos, asignación de rutas y seguimiento en tiempo real.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;" vertex="1" parent="1">
          <mxGeometry x="420" y="260" width="260" height="140" as="geometry" />
        </mxCell>

        <!-- Actor: Usuario Final -->
        <mxCell id="act_usuario" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;Usuario Final&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#e0e0e0&quot;&gt;Cliente que envía o recibe paquetes; consulta estado y agenda recogidas.&lt;/font&gt;&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- Actor: Mensajero -->
        <mxCell id="act_mensajero" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;Mensajero&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#e0e0e0&quot;&gt;Encargado de la entrega en campo; reporta estado y transmite ubicación.&lt;/font&gt;&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="260" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- Actor: Operador Logistico -->
        <mxCell id="act_operador" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;Operador Logístico&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#e0e0e0&quot;&gt;Gestiona despachos, consolida paquetes y monitorea operaciones.&lt;/font&gt;&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- Sistema Externo: API de Notificaciones -->
        <mxCell id="ext_notif" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;API de Notificaciones&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[External System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#e0e0e0&quot;&gt;Servicio externo de mensajería (SMS / Push / Email).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="160" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- Sistema Externo: Proveedor de Geolocalizacion -->
        <mxCell id="ext_geo" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;Proveedor Geolocalización&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[External System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#e0e0e0&quot;&gt;Servicio de mapas y ruteo cartográfico (Google Maps / Mapbox).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="380" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- Relaciones -->
        <mxCell id="rel_u_s" value="Rastrea envíos y agenda recogidas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0b4884;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="act_usuario" target="sys_redexpress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_m_s" value="Actualiza estado de entregas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0b4884;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="act_mensajero" target="sys_redexpress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_o_s" value="Gestiona rutas y despachos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0b4884;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="act_operador" target="sys_redexpress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_s_notif" value="Envía alertas de estado&#xa;[API REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#5F7387;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="sys_redexpress" target="ext_notif">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel_s_geo" value="Consulta coordenadas y rutas&#xa;[API REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#5F7387;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="sys_redexpress" target="ext_geo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
